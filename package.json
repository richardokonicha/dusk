{
  "name": "dusk",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/dusk",
    "packages/dusk/packages/*"
  ],
  "scripts": {
    "dev": "pnpm --dir packages/dusk dev",
    "build": "pnpm --dir packages/dusk build",
    "test": "pnpm --dir packages/dusk test",
    "test:coverage": "pnpm --dir packages/dusk test:coverage",
    "coverage": "pnpm test:coverage",
    "lint": "pnpm --dir packages/dusk lint",
    "typecheck": "pnpm --dir packages/dusk typecheck",
    "clean": "pnpm --dir packages/dusk clean && rm -rf node_modules dist",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.28.1",
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "license-checker": "^25.0.0",
    "vitepress": "^1.0.0"
  },
  "dependencies": {
    "adm-zip": "0.6.0",
    "sharp": "^0.35.4"
  }
}
