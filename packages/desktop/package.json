{
  "name": "@dusk/desktop",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/copy-renderer.js",
    "preview": "electron-vite preview",
    "package": "electron-builder",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win",
    "package:linux": "electron-builder --linux",
    "package:all": "electron-builder --publish never",
    "build:preview": "node scripts/set-preview-version.js",
    "publish": "electron-builder --publish always",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-reference-excluded.js",
    "notarize": "node scripts/notarize.js",
    "sign:win": "node scripts/sign-windows.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@dusk/shared": "workspace:*",
    "@google/generative-ai": "^0.21.0",
    "adm-zip": "^0.5.10",
    "archiver": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^3.6.0",
    "drizzle-orm": "^0.36.0",
    "electron-updater": "^6.3.0",
    "openai": "^4.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^3.0.0",
    "jsdom": "^25.0.0",
    "license-checker": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.1.9"
  }
}
